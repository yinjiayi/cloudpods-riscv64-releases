FROM ghcr.io/yinjiayi/cloudpods-alpine-build:3.22.2-go-1.24.9-0-riscv64.1 AS build

ARG SOURCE_REF=v0.0.29
ARG SOURCE_COMMIT
ENV GOPROXY=https://goproxy.cn,direct
RUN apk add --no-cache curl
RUN curl --fail --location --retry 10 --retry-all-errors \
      "https://codeload.github.com/rancher/local-path-provisioner/tar.gz/${SOURCE_COMMIT}" \
      --output /tmp/source.tar.gz && \
    mkdir -p /src && \
    tar -C /src --strip-components=1 -xzf /tmp/source.tar.gz && \
    rm -f /tmp/source.tar.gz
WORKDIR /src
RUN CGO_ENABLED=0 GOOS=linux GOARCH=riscv64 \
    go build -trimpath -ldflags='-s -w' -o /out/local-path-provisioner .

FROM ghcr.io/yinjiayi/k3s-alpine:3.20-riscv64.1
COPY --from=build /out/local-path-provisioner /usr/bin/local-path-provisioner
ENTRYPOINT ["/usr/bin/local-path-provisioner"]
