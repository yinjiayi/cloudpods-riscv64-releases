FROM ghcr.io/yinjiayi/cloudpods-alpine-build:3.22.2-go-1.24.9-0-riscv64.1 AS build

ARG SOURCE_REF=v0.7.2
ARG SOURCE_COMMIT
ENV GOPROXY=https://goproxy.cn,direct
RUN apk add --no-cache bash build-base curl
RUN curl --fail --location --retry 10 --retry-all-errors \
      "https://codeload.github.com/kubernetes-sigs/metrics-server/tar.gz/${SOURCE_COMMIT}" \
      --output /tmp/source.tar.gz && \
    mkdir -p /src && \
    tar -C /src --strip-components=1 -xzf /tmp/source.tar.gz && \
    rm -f /tmp/source.tar.gz
WORKDIR /src
RUN go mod download
RUN CGO_ENABLED=0 GOOS=linux GOARCH=riscv64 GOFLAGS=-buildvcs=false \
    go build -trimpath -ldflags='-s -w' -o /out/metrics-server \
    ./cmd/metrics-server

FROM ghcr.io/yinjiayi/k3s-alpine:3.20-riscv64.1
COPY --from=build /out/metrics-server /metrics-server
USER 65534
ENTRYPOINT ["/metrics-server"]
