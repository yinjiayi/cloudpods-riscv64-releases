FROM ghcr.io/yinjiayi/k3s-alpine:3.20-riscv64.1 AS source
ARG SOURCE_COMMIT
RUN apk add --no-cache curl && \
    curl --fail --location --retry 10 --retry-all-errors \
      "https://codeload.github.com/k3s-io/klipper-helm/tar.gz/${SOURCE_COMMIT}" \
      --output /tmp/source.tar.gz && \
    mkdir -p /src && \
    tar -C /src --strip-components=1 -xzf /tmp/source.tar.gz && \
    rm -f /tmp/source.tar.gz

FROM ghcr.io/yinjiayi/k3s-alpine:3.20-riscv64.1 AS extract
ARG HELM_VERSION=v3.16.1
ARG HELM_RISCV64_SHA256
RUN apk add --no-cache curl ca-certificates
RUN curl --fail --location \
      "https://get.helm.sh/helm-${HELM_VERSION}-linux-riscv64.tar.gz" \
      --output /tmp/helm.tar.gz && \
    echo "${HELM_RISCV64_SHA256}  /tmp/helm.tar.gz" | sha256sum -c && \
    tar xvzf /tmp/helm.tar.gz --strip-components=1 -C /usr/bin
COPY --from=source /src/entry /usr/bin/entry

FROM ghcr.io/yinjiayi/cloudpods-alpine-build:3.22.2-go-1.24.9-0-riscv64.1 AS plugins
ARG HELM_SET_STATUS_COMMIT
ARG HELM_MAPKUBEAPIS_COMMIT
ENV GOPROXY=https://goproxy.cn,direct
RUN apk add --no-cache curl ca-certificates build-base
COPY --from=extract /usr/bin/helm /usr/bin/helm
RUN curl --fail --location --retry 10 --retry-all-errors \
      "https://codeload.github.com/k3s-io/helm-set-status/tar.gz/${HELM_SET_STATUS_COMMIT}" \
      --output /tmp/helm-set-status.tar.gz && \
    mkdir -p /go/src/github.com/k3s-io/helm-set-status && \
    tar -C /go/src/github.com/k3s-io/helm-set-status --strip-components=1 \
      -xzf /tmp/helm-set-status.tar.gz && \
    rm -f /tmp/helm-set-status.tar.gz && \
    make -C /go/src/github.com/k3s-io/helm-set-status install
RUN curl --fail --location --retry 10 --retry-all-errors \
      "https://codeload.github.com/helm/helm-mapkubeapis/tar.gz/${HELM_MAPKUBEAPIS_COMMIT}" \
      --output /tmp/helm-mapkubeapis.tar.gz && \
    mkdir -p /go/src/github.com/helm/helm-mapkubeapis && \
    tar -C /go/src/github.com/helm/helm-mapkubeapis --strip-components=1 \
      -xzf /tmp/helm-mapkubeapis.tar.gz && \
    rm -f /tmp/helm-mapkubeapis.tar.gz && \
    make -C /go/src/github.com/helm/helm-mapkubeapis && \
    mkdir -p /root/.local/share/helm/plugins/helm-mapkubeapis && \
    cp -r /go/src/github.com/helm/helm-mapkubeapis/plugin.yaml \
      /go/src/github.com/helm/helm-mapkubeapis/bin \
      /go/src/github.com/helm/helm-mapkubeapis/config \
      /root/.local/share/helm/plugins/helm-mapkubeapis/

FROM ghcr.io/yinjiayi/k3s-alpine:3.20-riscv64.1
ARG BUILDDATE
LABEL org.opencontainers.image.created=$BUILDDATE
RUN apk add --no-cache ca-certificates jq bash && \
    adduser -D -u 1000 -s /bin/bash klipper-helm
WORKDIR /home/klipper-helm
COPY --chown=1000:1000 --from=plugins /root/.local/share/helm/plugins/ /home/klipper-helm/.local/share/helm/plugins/
COPY --from=extract /usr/bin/helm /usr/bin/entry /usr/bin/
RUN chmod 0755 /usr/bin/helm /usr/bin/entry
ENTRYPOINT ["entry"]
ENV STABLE_REPO_URL=https://charts.helm.sh/stable/
ENV TIMEOUT=
USER 1000
